# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
# cookie stores the session in an encrypted cookie (no sessions table).
# Do not use database until a session migration exists.
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# Ignored while NODE_ENV is development or test (all origins are allowed).
# Production reads this comma-separated list. The Vercel app
# https://project-wwc99.vercel.app and its preview hosts
# (https://project-wwc99-*.vercel.app) are always allowed as well.
# CORS_ORIGIN=http://localhost:3000

#--------------------------------------------------------------------
# Database
#--------------------------------------------------------------------
# development and test use SQLite (tmp/db.sqlite3) unless DB_CONNECTION=pg.
# production uses PostgreSQL. Prefer DATABASE_URL. Otherwise set DB_HOST,
# DB_PORT, DB_USER, DB_PASSWORD, and DB_DATABASE.
# DB_CONNECTION=sqlite
# DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/linkstream
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_DATABASE=linkstream
# DB_SSL=false

#--------------------------------------------------------------------
# Production (Railway) — set these in the Railway service variables.
# Do not commit real values. Do not invent the public URL; copy it from
# Railway after the service is created. Placeholder only:
# https://YOUR-RAILWAY-API.up.railway.app
#--------------------------------------------------------------------
# NODE_ENV=production
# HOST=0.0.0.0
# PORT=                 # leave unset; Railway injects PORT
# APP_KEY=              # node ace generate:key  (unique per environment)
# APP_URL=https://YOUR-RAILWAY-API.up.railway.app
# LOG_LEVEL=info
# TZ=UTC
# SESSION_DRIVER=cookie
# DATABASE_URL=         # Railway Postgres variable reference (private URL)
# DB_SSL=               # unset for *.railway.internal; true for the public proxy
# CORS_ORIGIN=https://project-wwc99.vercel.app
# DB_CONNECTION=pg      # optional; production already defaults to pg
